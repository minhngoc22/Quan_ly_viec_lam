@{
    ViewData["Title"] = "Tạo tài khoản quản trị";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow-lg border-0" style="width: 450px; border-radius: 15px;">
        <div class="card-header bg-primary text-white text-center py-3" style="border-top-left-radius: 15px; border-top-right-radius: 15px;">
            <h4 class="mb-0"><i class="fas fa-user-shield me-2"></i> Tạo tài khoản Admin phụ</h4>
        </div>
        <div class="card-body bg-light">
            <form method="post" asp-action="AddAdmin">
                <div class="mb-3">
                    <label class="form-label fw-semibold"><i class="fas fa-envelope me-2 text-primary"></i>Email</label>
                    <input name="email" type="email" class="form-control" placeholder="Nhập email quản trị..." required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold"><i class="fas fa-lock me-2 text-primary"></i>Mật khẩu</label>
                    <input name="password" type="password" class="form-control" placeholder="Nhập mật khẩu..." required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold"><i class="fas fa-user me-2 text-primary"></i>Họ tên</label>
                    <input name="fullname" class="form-control" placeholder="Nhập họ tên đầy đủ..." required />
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-plus-circle me-1"></i> Tạo tài khoản
                    </button>
                    <a asp-action="ManageUsers" class="btn btn-secondary px-4 ms-2">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
        <div class="card-footer text-center text-muted small">
            © 2025 - Quản lý tài khoản Admin
        </div>
    </div>
</div>
