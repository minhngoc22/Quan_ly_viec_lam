@model List<DoanWeb.Models.AdminDashboardViewModel.JobCommentStats>

@{
    ViewData["Title"] = "Thống kê bình luận";
}

<h1>📊 Thống kê bình luận các bài viết</h1>

<table class="table table-striped mt-3">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Tiêu đề việc làm</th>
            <th>Số bình luận</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@Model[i].Title</td>
                <td>@Model[i].CommentCount</td>
            </tr>
        }
    </tbody>
</table>
