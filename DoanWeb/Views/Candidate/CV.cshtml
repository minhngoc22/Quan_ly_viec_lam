@model DoanWeb.Models.CvViewModel
@{
    ViewData["Title"] = "CV của tôi";
}
<link rel="stylesheet" href="~/css/cv.css" />


<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">Hồ sơ ứng viên</h2>
        <p class="text-muted">Thông tin CV chi tiết của bạn</p>
    </div>

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="row g-0">
            <!-- 🌿 Cột trái -->
            <div class="col-md-4 cv-left text-white">
                <div class="text-center mb-4">
                    <img src="@Model.Avatar" alt="Avatar" class="rounded-circle mb-3 shadow" width="120" height="120" />


                    <h4 class="fw-bold">@Model.Cv.FullName</h4>
                    <hr />
                </div>

                <div class="cv-info mb-4">
                    <p><i class="bi bi-envelope me-2"></i>@Model.Cv.Email</p>
                    <p><i class="bi bi-telephone me-2"></i>@Model.Cv.Phone</p>
                    <p><i class="bi bi-geo-alt me-2"></i>@Model.Cv.Address</p>
                    @if (Model.Cv.DateOfBirth.HasValue)
                    {
                        <p><i class="bi bi-calendar3 me-2"></i>@Model.Cv.DateOfBirth.Value.ToString("dd/MM/yyyy")</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Cv.Gender))
                    {
                        <p><i class="bi bi-person me-2"></i>@Model.Cv.Gender</p>
                    }
                </div>

                <div class="cv-section mb-4">
                    <h6 class="cv-section-title"><i class="bi bi-lightning-charge-fill me-1"></i>Kỹ năng</h6>
                    <ul class="list-unstyled">
                        @foreach (var skill in Model.Skills)
                        {
                            <li>🌿 @skill.SkillName <small>– @skill.SkillLevel</small></li>
                        }
                    </ul>
                </div>

                <div class="cv-section">
                    <h6 class="cv-section-title"><i class="bi bi-bullseye me-1"></i>Mục tiêu nghề nghiệp</h6>
                    <p>@Model.Cv.CareerGoal</p>
                </div>
            </div>

            <!-- 📝 Cột phải -->
            <div class="col-md-8 p-4 cv-right">
                <div class="mb-4">
                    <h5 class="fw-bold text-success"><i class="bi bi-briefcase-fill me-2"></i>Kinh nghiệm làm việc</h5>
                    @if (Model.Experiences.Any())
                    {
                        @foreach (var exp in Model.Experiences)
                        {
                            <div class="mb-3">
                                <b>@exp.Position</b> tại <span class="text-success">@exp.CompanyName</span><br />
                                <small>@exp.StartDate?.ToString("MM/yyyy") - @exp.EndDate?.ToString("MM/yyyy")</small>
                                <p>@exp.Description</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Chưa có kinh nghiệm được thêm.</p>
                    }
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-success"><i class="bi bi-mortarboard-fill me-2"></i>Học vấn</h5>
                    @if (Model.Educations.Any())
                    {
                        @foreach (var edu in Model.Educations)
                        {
                            <div class="mb-3">
                                <b>@edu.SchoolName</b> - @edu.Major <br />
                                <small>@edu.StartYear - @edu.EndYear</small>
                                <p>@edu.Description</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Chưa có thông tin học vấn.</p>
                    }
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-success"><i class="bi bi-award-fill me-2"></i>Chứng chỉ</h5>
                    @if (Model.Certificates.Any())
                    {
                        @foreach (var cer in Model.Certificates)
                        {
                            <div class="mb-2">
                                <b>@cer.CertificateName</b> - <small>@cer.Organization</small> (@cer.Year)
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Chưa có chứng chỉ.</p>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Cv.FilePath))
                {
                    <div class="mt-4">
                        <a href="@Model.Cv.FilePath" target="_blank" class="btn btn-outline-danger rounded-pill px-4">
                            <i class="bi bi-file-earmark-pdf-fill"></i> Xem CV PDF
                        </a>
                    </div>
                }

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="EditCV" class="btn btn-warning rounded-pill px-4 shadow-sm">
                        <i class="bi bi-pencil-square"></i> Chỉnh sửa
                    </a>
                    <form asp-action="DeleteCV" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa CV này không?');">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                            <i class="bi bi-trash-fill"></i> Xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
