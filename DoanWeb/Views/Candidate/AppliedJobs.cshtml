@model List<DoanWeb.Models.AppliedJobViewModel>

<div class="container my-4">
    <!-- Header -->
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-card-checklist fs-2 text-primary me-3"></i>
        <h2 class="fw-bold mb-0">Việc làm đã ứng tuyển</h2>
    </div>

    <!-- Job cards -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var job in Model)
        {
            <div class="col">
                <div class="card h-100 job-card shadow-sm ">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@job.Title</h5>
                        <p class="mb-1 text-muted"><i class="bi bi-building"></i> @job.CompanyName</p>
                        <p class="mb-1 text-muted"><i class="bi bi-geo-alt"></i> @job.ProvinceName</p>
                        <p class="mb-1 text-muted"><i class="bi bi-briefcase"></i> @job.CategoryName</p>
                        <p class="mb-1">
                            <i class="fas fa-money-bill-wave me-2 text-success"></i>
                            @(string.IsNullOrEmpty(job.Salary) ? "Liên hệ" : job.Salary)

                        </p>
                        <p class="text-secondary small mb-3">
                            Ngày đăng: @job.CreatedAt.ToString("dd/MM/yyyy")
                        </p>

                        <a asp-controller="Job" asp-action="JobDetail" asp-route-id="@job.JobId"
                           class="btn btn-outline-primary mt-auto w-100 fw-semibold rounded-pill">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
