@model DoanWeb.Models.CvViewModel
@{
    ViewData["Title"] = "Tạo CV mới";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Tạo CV mới</h2>
        <p class="text-muted">Điền đầy đủ thông tin dưới đây để tạo CV</p>
    </div>

    <form asp-action="CreateCV" enctype="multipart/form-data">
        <div class="card shadow-sm border-0 rounded-4 p-4">

            <div class="mb-3">
                <label class="form-label fw-bold">Họ tên</label>
                <input asp-for="Cv.FullName" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <input asp-for="Cv.Email" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Số điện thoại</label>
                <input asp-for="Cv.Phone" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mục tiêu nghề nghiệp</label>
                <textarea asp-for="Cv.CareerGoal" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">File CV (PDF)</label>
                <input type="file" name="file" class="form-control" accept=".pdf" />
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-success px-4">Lưu CV</button>
            </div>
        </div>
    </form>
</div>
