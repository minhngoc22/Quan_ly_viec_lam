@{
    ViewData["Title"] = "Chọn loại đăng nhập";
}

<div class="container mt-5">
    <div class="row justify-content-center g-4">
        <!-- Cột trái: Lựa chọn loại đăng nhập -->
        <div class="col-md-6 d-flex flex-column justify-content-center align-items-center">
            <div class="card shadow-lg rounded-4 p-4 w-100 text-center">
                <h2 class="mb-4">Chọn loại đăng nhập</h2>

                <div class="d-flex flex-column gap-3 align-items-center">
                    <a class="btn btn-gradient-primary btn-lg fw-bold px-4 py-2"
                       style="min-width: 260px;"
                       asp-controller="Account" asp-action="LoginCandidate">
                        <i class="bi bi-person-fill me-2"></i> Ứng viên
                    </a>
                    <a class="btn btn-gradient-success btn-lg fw-bold px-4 py-2"
                       style="min-width: 260px;"
                       asp-controller="Account" asp-action="LoginEmployer">
                        <i class="bi bi-building me-2"></i> Nhà tuyển dụng
                    </a>
                    <a class="btn btn-gradient-danger btn-lg fw-bold px-4 py-2"
                       style="min-width: 260px;"
                       asp-controller="Account" asp-action="LoginAdmin">
                        <i class="bi bi-shield-lock-fill me-2"></i> Quản trị viên
                    </a>
                </div>

                <div class="mt-4">
                    <span>Bạn chưa có tài khoản? </span>
                    <a asp-controller="Account" asp-action="ChooseRegister" class="fw-bold text-decoration-none">
                        Đăng ký ngay
                    </a>
                </div>
            </div>
        </div>

        <!-- Cột phải: Banner slideshow -->
        <div class="col-md-6 d-flex justify-content-center align-items-center">
            <div id="loginBannerCarousel" class="carousel slide w-100 rounded shadow" data-bs-ride="carousel" data-bs-interval="3000">
                <div class="carousel-inner rounded">
                    <div class="carousel-item active">
                        <img src="~/image/banner1.jpg" class="d-block w-100" alt="Banner 1">
                    </div>
                    <div class="carousel-item">
                        <img src="~/image/banner2.jpg" class="d-block w-100" alt="Banner 2">
                    </div>
                    <div class="carousel-item">
                        <img src="~/image/banner3.jpg" class="d-block w-100" alt="Banner 3">
                    </div>
                </div>

                <!-- Controls -->
                <button class="carousel-control-prev" type="button" data-bs-target="#loginBannerCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#loginBannerCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>

                <!-- Indicators -->
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#loginBannerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#loginBannerCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#loginBannerCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">


