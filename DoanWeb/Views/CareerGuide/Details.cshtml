@model DoanWeb.Models.CareerGuide
@{
    ViewData["Title"] = "Chi tiết cẩm nang - " + Model.Title;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- Tiêu đề -->
                <h1 class="fw-bold text-primary mb-3 text-center">@Model.Title</h1>
                <!-- Ảnh minh họa -->
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="@Url.Content(Model.Image.StartsWith("/") ? Model.Image : $"/images/guides/{Model.Image}")"
                         class="img-fluid w-100"
                         alt="@Model.Title"
                         style="max-height: 380px; object-fit: cover;" />
                }

                <div class="card-body p-4">
                   

                    <!-- Meta -->
                    <div class="text-muted mb-3 small">
                        <i class="bi bi-person-circle me-1"></i><strong>@Model.Author</strong>
                        <span class="mx-2">|</span>
                        <i class="bi bi-calendar3 me-1"></i>@(Model.PostedDate?.ToString("dd/MM/yyyy") ?? "Không xác định")
                        <span class="mx-2">|</span>
                        <i class="bi bi-tag me-1"></i>@Model.Category
                        <span class="mx-2">|</span>
                        <i class="bi bi-eye me-1"></i>@Model.Views lượt xem
                    </div>

                    <hr class="my-3" />

                    <!-- Mô tả -->
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="lead fst-italic text-secondary">
                            “@Model.Description”
                        </p>
                    }

                    <!-- Nội dung -->
                    <div class="mt-4" style="white-space: pre-line; font-size: 1.05rem; line-height: 1.7;">
                        @Html.Raw(Model.Content)
                    </div>

                    <hr class="mt-4" />

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-primary">
                            ← Quay lại danh sách
                        </a>

                        <span class="text-muted small">
                            Cập nhật lần cuối: @(Model.PostedDate?.ToString("dd/MM/yyyy"))
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
