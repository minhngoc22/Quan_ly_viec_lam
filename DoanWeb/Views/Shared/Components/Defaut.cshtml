@model Tuple<List<DoanWeb.Models.JobCategory>, List<DoanWeb.Models.JobCategory>>

<div class="row">
    <div class="col-6">
        @foreach (var cat in Model.Item1)
        {
            <a class="dropdown-item" asp-controller="Job" asp-action="Index" asp-route-categoryId="@cat.CategoryId">
                @cat.CategoryName
            </a>
        }
    </div>
    <div class="col-6">
        @foreach (var cat in Model.Item2)
        {
            <a class="dropdown-item" asp-controller="Job" asp-action="Index" asp-route-categoryId="@cat.CategoryId">
                @cat.CategoryName
            </a>
        }
    </div>
</div>
