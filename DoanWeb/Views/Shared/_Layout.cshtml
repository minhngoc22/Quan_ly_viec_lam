<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoanWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/featured-industries.css" asp-append-version="true" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.js"></script>
    <script src="~/js/candidate-status.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3 navbar-custom">
            <div class="container-fluid">
                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center me-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="@Url.Content("~/image/logo.jpg")" height="40" class="me-2">
                    <span class="fw-bold text-white">Jobify</span>
                </a>

                <!-- Menu chính căn giữa -->
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav d-flex justify-content-center w-100">
                        <li class="nav-item mx-3">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Trang chủ
                            </a>
                        </li>

                        <li class="nav-item dropdown mx-3">
                            <a class="nav-link dropdown-toggle" href="#" id="jobsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Việc làm
                            </a>
                            <div class="dropdown-menu p-3" aria-labelledby="jobsDropdown" style="min-width:650px;">
                                <div class="row">
                                    <div class="col-4 pe-2">
                                        <h6 class="dropdown-header c">VIỆC LÀM</h6>
                                        <a class="dropdown-item" asp-controller="Job" asp-action="AllJobs">Tìm việc làm</a>
                                        <a class="dropdown-item" asp-controller="Candidate" asp-action="SavedJobs">Việc làm đã lưu</a>
                                        <a class="dropdown-item" asp-controller="Candidate" asp-action="AppliedJobs">Việc làm đã ứng tuyển</a>
                                        <a class="dropdown-item" asp-controller="Candidate" asp-action="SuggestedJobs">Việc làm phù hợp</a>

                                        <h6 class="dropdown c mt-2">CÔNG TY</h6>
                                        <a class="dropdown-item" href="@Url.Action("Index", "Home")#top-companies-section">Danh sách công ty</a>
                                        <a class="dropdown-item" href="@Url.Action("Index", "Home")#top-companies-section">Top công ty</a>

                                    </div>
                                    <div class="col-8">
                                        <div class="row g-1">
                                            <div class="col-6">
                                                <h6 class="dropdown-header c">VIỆC LÀM THEO VỊ TRÍ</h6>
                                                @await Component.InvokeAsync("JobCategoryMenu")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>

                        <li class="nav-item mx-3">
                            <a class="nav-link" asp-controller="CareerGuide" asp-action="Index">
                                <i class="bi bi-journal-text me-1"></i>Cẩm nang
                            </a>
                        </li>


                    </ul>
                </div>

                <!-- Menu bên phải -->
                <ul class="navbar-nav ms-auto me-3">
                    @if (Context.Session.GetString("UserName") != null)
                    {
                        var role = Context.Session.GetString("UserRole");

                        <!-- 🔔 Thông báo -->
                        <li class="nav-item dropdown">
                            <a class="nav-link position-relative" href="#" id="notificationDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-bell" style="font-size: 20px;"></i>
                                <span id="notificationBadge" class="badge bg-danger position-absolute top-0 start-100 translate-middle" style="display:none;">
                                    0
                                </span>
                            </a>
                            <ul id="notificationDropdownMenu" class="dropdown-menu dropdown-menu-end p-2"
                                aria-labelledby="notificationDropdown" style="min-width:300px;">
                                <li><span class="dropdown-item text-muted">Đang tải...</span></li>
                            </ul>
                        </li>




                        <!-- 👤 Dropdown người dùng cải tiến -->
                        <li class="nav-item dropdown">
                            <a class="nav-link d-flex align-items-center dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                             @* //   <img src="~/images/default-avatar.png" alt="Avatar" class="rounded-circle me-2" style="width:32px; height:32px; object-fit:cover;"> *@
                                <span>Xin chào, @Context.Session.GetString("UserName")</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown" style="min-width:200px;">
                                @if (role == "Candidate")
                                {
                                    <li><a class="dropdown-item d-flex align-items-center" asp-controller="Candidate" asp-action="Profile"><i class="fas fa-user me-2 text-primary"></i>Hồ sơ</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center" asp-controller="Candidate" asp-action="Dashboard"><i class="fas fa-tachometer-alt me-2 text-success"></i>Bảng điều khiển</a></li>
                                }
                                else if (role == "Employer")
                                {
                                    <li><a class="dropdown-item d-flex align-items-center" asp-controller="Employer" asp-action="Dashboard"><i class="fas fa-tachometer-alt me-2 text-success"></i>Bảng điều khiển</a></li>
                                }
                                else if (role == "Admin")
                                {
                                    <li><a class="dropdown-item d-flex align-items-center" asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-cogs me-2 text-warning"></i>Bảng điều khiển</a></li>
                                }

                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center text-danger fw-bold" href="javascript:void(0);" onclick="confirmLogout()">
                                        <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>

                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="btn btn-login d-flex align-items-center gap-2" asp-controller="Account" asp-action="ChooseLogin">
                                <img src="~/image/icon10.png" alt="login icon" width="20" height="20">
                                Đăng Nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-register d-flex align-items-center gap-2" asp-controller="Account" asp-action="ChooseRegister">
                                <img src="~/image/icon11.png" alt="register icon" width="20" height="20">
                                Đăng Ký
                            </a>
                        </li>
                    }
                </ul>

                </ul>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom text-light pt-5 pb-3 mt-5 shadow-lg">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3 text-uppercase">Jobify</h5>
                    <p class="small">
                        Nền tảng kết nối việc làm, giúp ứng viên tìm kiếm cơ hội nghề nghiệp
                        và nhà tuyển dụng tiếp cận nhân tài nhanh chóng.
                    </p>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3 text-uppercase">Liên kết nhanh</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a class="text-light text-decoration-none hover-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="mb-2"><a class="text-light text-decoration-none hover-link" asp-controller="Job" asp-action="AllJobs">Tìm việc làm</a></li>
                        <li class="mb-2">
                            <a class="text-light text-decoration-none hover-link"
                               href="@($"{Url.Action("Index", "Home")}#top-companies-section")">
                                Công ty
                            </a>
                        </li>
                       
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h5 class="fw-bold mb-3 text-uppercase">Liên hệ</h5>
                    <p class="mb-1"><i class="bi bi-envelope me-2"></i> support@jobify.vn</p>
                    <p class="mb-1"><i class="bi bi-telephone me-2"></i> +84 123 456 789</p>
                    <p class="mb-3"><i class="bi bi-geo-alt me-2"></i> Khu B Đại học Xây dựng Miều Tây, Đường Mậu Thân 2, Phường Phước Hậu, Vĩnh Long</p>
                    <div>
                        <a href="#" class="text-light fs-5 me-3"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-light fs-5 me-3"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="text-light fs-5 me-3"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-light fs-5"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
            </div>
            <hr class="bg-light my-4" />
            <div class="text-center small">
                &copy; 2025 <span class="fw-bold">Jobify</span>. All rights reserved.
                | <a class="text-light text-decoration-none hover-link" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function confirmLogout() {
            Swal.fire({
                title: 'Đăng xuất?',
                text: "Bạn có chắc chắn muốn đăng xuất không?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Đăng xuất',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Logout", "Account")';
                }
            })
        }
    </script>
</body>


</html>
