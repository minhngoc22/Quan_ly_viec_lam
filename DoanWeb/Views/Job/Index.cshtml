@model DoanWeb.Models.JobSearchViewModel

@{
    ViewData["Title"] = "Tìm việc làm";
}

<!-- Hero Bar -->
<div class="hero-section text-center text-white py-5"
     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <h1 class="fw-bold mb-3 display-5">
            Tìm Việc Làm <span style="color:#FFD700;">Mơ Ước</span> Của Bạn
        </h1>
        <p class="mb-4 fs-5">Khám phá hàng nghìn cơ hội việc làm từ các công ty hàng đầu</p>

        <!-- Thanh tìm kiếm -->
        <form method="get" asp-controller="Job" asp-action="Index"
              id="jobSearchForm"
              class="search-bar d-flex align-items-center mx-auto border rounded-pill overflow-hidden"
              style="max-width: 900px; background:white;">
            <div class="position-relative flex-grow-1 border-end">
                <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" id="keywordInput" name="keyword" value="@Model.Keyword"
                       class="form-control border-0 ps-5"
                       placeholder="Tìm kiếm công việc, vị trí..." />
            </div>
            <div class="position-relative" style="width: 220px;">
                <i class="fas fa-map-marker-alt position-absolute top-50 start-0 translate-middle-y ms-3 text-danger"></i>
                <select id="provinceSelect" asp-for="ProvinceId" asp-items="Model.Provinces"
                        class="form-select border-0 ps-5">
                    <option value="">Địa điểm...</option>
                </select>
            </div>
            <button type="submit" class="btn btn-gradient1">Tìm kiếm 🔍</button>
        </form>
    </div>
</div>

<!-- Toast giữa trang -->
<div id="center-toast-container" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2000;"></div>

<!-- Nút Quay về Trang Chủ luôn hiện -->
<div class="text-center my-4">
    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-primary fw-semibold">
        ← Quay về Trang Chủ
    </a>
</div>

<!-- Chỉ render danh sách công việc nếu có -->
@if (Model.Jobs != null && Model.Jobs.Any())
{
    <div class="container mt-5">
        <h3 class="mb-4 text-primary fw-bold text-center">Kết quả tìm kiếm</h3>
        <div class="row">
            @foreach (var job in Model.Jobs)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 job-card rounded-4 position-relative overflow-hidden">

                        @if (!string.IsNullOrEmpty(job.JobType))
                        {
                            <div class="position-absolute top-0 start-0 m-2 px-3 py-1 rounded-pill text-white text-truncate"
                                 style="background-color:#0d6efd; max-width:70%; font-size:0.75rem; z-index:2;">
                                @job.JobType
                            </div>
                        }

                        <button type="button" class="btn btn-light rounded-circle position-absolute top-0 end-0 m-2 favorite-btn shadow-sm"
                                style="width:36px; height:36px; display:flex; align-items:center; justify-content:center; z-index:3;">
                            <i class="far fa-heart text-danger"></i>
                        </button>

                        <div class="card-body pt-4">
                            <div class="d-flex align-items-center mb-3">
                                <img src="@(string.IsNullOrEmpty(job.Company?.Logo) ? Url.Content("~/images/default-logo.png") : job.Company.Logo)"
                                     alt="@job.Company?.CompanyName"
                                     class="rounded me-3"
                                     style="width:60px;height:60px;object-fit:cover;">
                                <div>
                                    <h5 class="card-title mb-1">@job.Title</h5>
                                    <p class="text-muted mb-0">@job.Company?.CompanyName</p>
                                </div>
                            </div>
                            <p class="text-muted small mb-3">
                                <i class="fas fa-briefcase me-1 text-secondary"></i>
                                @(job.Category?.CategoryName ?? "Chưa cập nhật") <br>
                                <i class="fas fa-map-marker-alt me-1 text-danger"></i>
                                @((!string.IsNullOrEmpty(job.Location) ? job.Location : "")
                                    + (string.IsNullOrEmpty(job.Location) ? "" : " - ")
                                    + (job.Province?.ProvinceName ?? "Chưa cập nhật")) <br>
                                <i class="fas fa-money-bill-wave me-1 text-success"></i>
                                @(string.IsNullOrEmpty(job.Salary) ? "Liên hệ" : job.Salary)
                            </p>
                            <a asp-controller="Job" asp-action="JobDetail" asp-route-id="@job.JobId"
                               class="btn btn-outline-primary w-100 fw-semibold rounded-pill">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        document.getElementById('provinceSelect').addEventListener('change', function () {
            document.getElementById('jobSearchForm').submit();
        });

        const jobCount = @Model.Jobs?.Count ?? 0;
        const message = jobCount > 0
            ? `Đã tìm thấy ${jobCount} công việc`
            : `Không tìm thấy công việc nào`;

        function showCenterToast(message, type = 'info') {
            if(!message) return;

            const container = document.getElementById('center-toast-container');
            const toast = document.createElement('div');

            toast.style.minWidth = '300px';
            toast.style.padding = '15px 25px';
            toast.style.backgroundColor = type === 'info' ? '#0d6efd' : '#ffc107';
            toast.style.color = 'white';
            toast.style.borderRadius = '12px';
            toast.style.boxShadow = '0 4px 15px rgba(0,0,0,0.2)';
            toast.style.textAlign = 'center';
            toast.style.fontWeight = '500';
            toast.style.fontSize = '1rem';
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s, transform 0.3s';
            toast.innerText = message;

            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '1';
                toast.style.transform = 'translate(-50%, -50%) scale(1)';
            }, 10);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, -50%) scale(0.9)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        showCenterToast(message, jobCount > 0 ? 'info' : 'warning');
    </script>
}
