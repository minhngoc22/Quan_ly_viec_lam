@model DoanWeb.Models.Job
@{
    ViewData["Title"] = "Chi tiết việc làm";
}
<link rel="stylesheet" href="~/css/job-detail.css" asp-append-version="true" />

<!-- Hiển thị thông báo -->
<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 2000;"></div>


<div class="container my-5">
    <div class="row">
        <!-- Cột trái: Nội dung chi tiết -->
        <div class="col-lg-8">

            <!-- Header -->
            <div class="card shadow-sm p-4 mb-4 rounded-4">
                <div class="row align-items-center">
                    <!-- Thông tin công việc -->
                    <div class="col-md-8">
                        <h2 class="fw-bold mb-2">@Model.Title</h2>
                        <p class="text-muted mb-1">
                            <i class="fas fa-building me-2 text-secondary"></i>
                            @Model.Company?.CompanyName
                        </p>
                        <p class="mb-1">
                            <i class="fas fa-map-marker-alt me-2 text-danger"></i>
                            @Model.Location - @Model.Province?.ProvinceName
                        </p>
                        <p class="mb-1">
                            <i class="fas fa-money-bill-wave me-2 text-success"></i>
                            @(string.IsNullOrEmpty(Model.Salary) ? "Liên hệ" : Model.Salary)
                        </p>

                        <p class="mb-0">
                            <i class="fas fa-calendar-alt me-2 text-warning"></i>
                            Hạn nộp: @Model.ExpireDate?.ToString("dd/MM/yyyy")
                        </p>
                    </div>

                    <!-- Logo công ty -->
                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        @if (!string.IsNullOrEmpty(Model.Company?.Logo))
                        {
                            <img src="@Model.Company.Logo" alt="@Model.Company.CompanyName" class="img-fluid" style="max-height:100px;">
                        }
                    </div>
                </div>
            </div>

            <!-- Thanh menu nhanh -->
            <div class="sticky-top bg-white border-bottom py-2 mb-4" style="top:70px; z-index:1000;">
                <div class="d-flex justify-content-center gap-4">
                    <a href="#section-description" class="nav-link fw-bold text-primary">Mô tả</a>
                    <a href="#section-requirements" class="nav-link fw-bold text-primary">Yêu cầu</a>
                    <a href="#section-benefits" class="nav-link fw-bold text-primary">Quyền lợi</a>
                    <a href="#section-contact" class="nav-link fw-bold text-primary">Liên hệ</a>
                </div>
            </div>

            <div id="section-description" class="mb-2">
                <h4 class="fw-bold mb-3">Mô tả công việc</h4>
                <ul>
                    @foreach (var line in (Model.Description ?? "").Split("\n"))
                    {
                        if (!string.IsNullOrWhiteSpace(line))
                        {
                            <li>@line</li>
                        }
                    }
                </ul>
            </div>

            <div id="section-requirements" class="mb-2">
                <h4 class="fw-bold mb-3">Yêu cầu công việc</h4>
                <ul>
                    @foreach (var line in (Model.Requirements ?? "").Split("\n"))
                    {
                        if (!string.IsNullOrWhiteSpace(line))
                        {
                            <li>@line</li>
                        }
                    }
                </ul>
            </div>

            <div id="section-benefits" class="mb-2">
                <h4 class="fw-bold mb-3">Quyền lợi</h4>
                <ul>
                    @foreach (var line in (Model.Benefits ?? "").Split("\n"))
                    {
                        if (!string.IsNullOrWhiteSpace(line))
                        {
                            <li>@line</li>
                        }
                    }
                </ul>
            </div>

            <div id="section-contact" class="mb-2">
                <h4 class="fw-bold mb-3">Liên hệ</h4>
                <ul>
                    <li><b>Email:</b> @Model.Employer?.EmployerNavigation?.Email</li>
                    <li><b>Điện thoại:</b> @Model.Employer?.Phone</li>
                </ul>
            </div>

          


            <!-- Nút điều hướng -->
            <div class="mb-5">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary rounded-pill px-4 me-2">
                    ← Quay lại danh sách
                </a>
                <a asp-controller="Job" asp-action="Apply" asp-route-id="@Model.JobId"
                   class="btn btn-primary rounded-pill px-4">
                    Ứng tuyển ngay
                </a>
            </div>
        </div>

        <!-- Cột phải: Việc làm gợi ý -->
        <!-- Cột phải: Việc làm gợi ý -->
        <div class="col-lg-4">
            @if (ViewBag.SimilarJobs != null && ViewBag.SimilarJobs.Count > 0)
            {
                <h5 class="fw-bold mb-3">Việc làm gợi ý</h5>
                <div class="d-flex flex-column gap-3">
                    @foreach (var job in ViewBag.SimilarJobs)
                    {
                        <div class="card shadow-sm border-0 rounded-4 p-2">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(job.Company?.Logo))
                                {
                                    <img src="@job.Company.Logo" alt="@job.Company.CompanyName"
                                         class="img-fluid me-2" style="max-height:50px; max-width:70px;">
                                }
                                <div>
                                    <h6 class="fw-bold mb-0">@job.Title</h6>
                                    <p class="text-muted small mb-0">@job.Company?.CompanyName</p>
                                    <p class="text-muted small mb-0">
                                        <i class="fas fa-map-marker-alt me-1 text-danger"></i>
                                        @job.Location - @job.Province?.ProvinceName
                                    </p>
                                </div>
                            </div>
                            <a asp-controller="Job" asp-action="JobDetail" asp-route-id="@job.JobId"
                               class="btn btn-outline-primary btn-sm rounded-pill mt-2 w-100">Xem thêm</a>
                        </div>
                    }
                </div>
            }

            <!-- 💬 Bình luận -->
            <!-- 💬 Bình luận -->
         <div id="section-comments" class="mt-5">
    <h5 class="fw-bold mb-3">Bình luận</h5>

    @if (ViewBag.Comments != null && ((List<DoanWeb.Models.JobCommentViewModel>)ViewBag.Comments).Count > 0)
    {
        <div class="border rounded-3 p-3 bg-light">
            @foreach (var c in (List<DoanWeb.Models.JobCommentViewModel>)ViewBag.Comments)
            {
                <div class="comment-item position-relative mb-2 pb-2 border-bottom">
                    <div class="d-flex align-items-start">
                        <!-- 🔹 Avatar -->
                        <div class="me-2">
                            <img src="@c.Avatar" alt="@c.UserName" class="rounded-circle"
                                 style="width:40px;height:40px;object-fit:cover; background-color:@c.AvatarColor;" />
                        </div>
                        <div class="flex-grow-1">
                            <strong>@c.UserName</strong>
                            <div class="text-dark small mt-1">@c.CommentText</div>
                        </div>
                    </div>
                    <small class="text-muted position-absolute top-0 end-0 me-2 mt-1">
                        @c.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Chưa có bình luận nào.</p>
    }

    <form id="commentForm" asp-action="AddComment" asp-controller="Job" method="post" class="mt-3">
        <input type="hidden" name="jobId" value="@Model.JobId" />
        <div class="mb-2">
            <textarea name="content" class="form-control rounded-3 small" rows="2"
                      placeholder="Nhập bình luận của bạn..."></textarea>
        </div>
        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">Gửi</button>
    </form>
</div>



        </div>

    </div>
</div>

@section Scripts {
    @{
        // Lấy UserId từ Session
        var userId = ViewContext.HttpContext.Session.GetInt32("UserId") ?? 0;
        var isLoggedIn = userId > 0;
    }
    <script>
        // Chuyển biến Razor sang JS
        const isLoggedIn = @isLoggedIn.ToString().ToLower(); // true hoặc false

        // Lấy thông báo từ TempData an toàn
        const toastSuccess = @Html.Raw(Json.Serialize(TempData["CommentSuccess"] ?? ""));
        const toastError = @Html.Raw(Json.Serialize(TempData["CommentError"] ?? ""));

        function showToast(message, type = 'success') {
            if (!message) return;

            const container = document.getElementById('toast-container');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type} border-0 show`;
            toast.setAttribute('role', 'alert');
            toast.setAttribute('aria-live', 'assertive');
            toast.setAttribute('aria-atomic', 'true');
            toast.style.minWidth = '250px';
            toast.style.marginBottom = '0.5rem';
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            `;
            container.appendChild(toast);

            setTimeout(() => { toast.classList.remove('show'); toast.remove(); }, 3000);
        }

        // Hiển thị toast
        showToast(toastSuccess, 'success');
        showToast(toastError, 'danger');

        // Kiểm tra đăng nhập khi gửi bình luận
        const commentForm = document.getElementById("commentForm");
        if (commentForm) {
            commentForm.addEventListener("submit", function (e) {
                if (!isLoggedIn) {
                    e.preventDefault();
                    if (confirm("Bạn cần đăng nhập để bình luận. Chuyển đến trang đăng nhập?")) {
                        window.location.href = '/Account/ChooseLogin';
                    }
                }
            });
        }
    </script>
}

