@model DoanWeb.Models.JobFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa việc làm";
}
<link rel="stylesheet" href="~/css/jobform-a4.css" />

<div class="job-form-a4 container my-4">
    <div class="card shadow-sm border-0 rounded-2">
        <div class="card-header bg-primary text-white text-center py-2">
            <h4 class="mb-0"><i class="bi bi-pencil-square me-1"></i> Chỉnh sửa tin tuyển dụng</h4>
        </div>

        <div class="card-body p-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success small mb-2">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger small mb-2">@TempData["ErrorMessage"]</div>
            }

            <form asp-action="EditJob" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Job.JobId" />

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="Job.Title" class="form-label fw-bold small"></label>
                        <input asp-for="Job.Title" class="form-control form-control-sm" />
                        <span asp-validation-for="Job.Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Job.Salary" class="form-label fw-bold small"></label>
                        <input asp-for="Job.Salary" class="form-control form-control-sm" />
                        <span asp-validation-for="Job.Salary" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-2">
                    <label asp-for="Job.Description" class="form-label fw-bold small"></label>
                    <textarea asp-for="Job.Description" class="form-control form-control-sm" rows="3"></textarea>
                    <span asp-validation-for="Job.Description" class="text-danger small"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Job.Requirements" class="form-label fw-bold small"></label>
                    <textarea asp-for="Job.Requirements" class="form-control form-control-sm" rows="3"></textarea>
                    <span asp-validation-for="Job.Requirements" class="text-danger small"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Job.Benefits" class="form-label fw-bold small"></label>
                    <textarea asp-for="Job.Benefits" class="form-control form-control-sm" rows="3"></textarea>
                    <span asp-validation-for="Job.Benefits" class="text-danger small"></span>
                </div>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="Job.Location" class="form-label fw-bold small"></label>
                        <input asp-for="Job.Location" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Job.ProvinceId" class="form-label fw-bold small"></label>
                        <select asp-for="Job.ProvinceId" asp-items="Model.Provinces" class="form-select form-select-sm"></select>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="Job.CategoryId" class="form-label fw-bold small"></label>
                        <select asp-for="Job.CategoryId" asp-items="Model.Categories" class="form-select form-select-sm"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Job.CompanyId" class="form-label fw-bold small"></label>
                        <select asp-for="Job.CompanyId" asp-items="Model.Companies" class="form-select form-select-sm"></select>
                    </div>
                </div>
                <!-- Giới tính & Số lượng -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="Job.GenderRequirement" class="form-label fw-bold small">Giới tính</label>
                        <select asp-for="Job.GenderRequirement" class="form-select form-select-sm">
                            <option value="">Không yêu cầu</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Job.VacancyCount" class="form-label fw-bold small">Số lượng</label>
                        <input asp-for="Job.VacancyCount" type="number" min="1" class="form-control form-control-sm" placeholder="VD: 5" />
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="Job.JobType" class="form-label fw-bold small"></label>
                        <select asp-for="Job.JobType" class="form-select form-select-sm">
                            <option value="">-- Chọn --</option>
                            <option value="Full-time">Full-time</option>
                            <option value="Part-time">Part-time</option>
                            <option value="Internship">Thực tập</option>
                            <option value="Remote">Remote</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Job.ExpireDate" class="form-label fw-bold small"></label>
                        <input asp-for="Job.ExpireDate" type="date" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="mb-2">
                    <label asp-for="Job.Keywords" class="form-label fw-bold small"></label>
                    <input asp-for="Job.Keywords" class="form-control form-control-sm" />
                </div>

                <div class="mb-2">
                    <label asp-for="Job.ImageUrl" class="form-label fw-bold small"></label>
                    <input asp-for="Job.ImageUrl" type="file" class="form-control form-control-sm" name="ImageFile" />
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <a asp-action="ManageJobs" class="btn btn-outline-secondary btn-sm px-3">Quay lại</a>
                    <button type="submit" class="btn btn-primary btn-sm px-3">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
