@model DoanWeb.Models.EmployerProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ Nhà tuyển dụng";
}
<link rel="stylesheet" href="~/css/profile_e.css" asp-append-version="true" />

<div class="profile-container">
    <h2 class="text-center text-success fw-bold mb-4">
        <i class="bi bi-building-check"></i> @ViewData["Title"]
    </h2>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success text-center mb-4" id="successMessage">
            <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.SuccessMessage
        </div>
    }

    <div class="row g-4">
        <!-- 👤 Thông tin cá nhân -->
        <div class="col-lg-6">
            <div class="card card-custom h-100">
                <div class="card-header-custom bg-primary text-white">
                    <i class="bi bi-person-badge me-2"></i> Thông tin cá nhân
                </div>
                <div class="card-body">
                    <form asp-action="EditPersonal" method="post">
                        <input type="hidden" asp-for="Personal.EmployerId" />
                        <div class="mb-3">
                            <label class="form-label">Họ và tên</label>
                            <input type="text" class="form-control" asp-for="Personal.FullName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Chức vụ</label>
                            <input type="text" class="form-control" asp-for="Personal.Position" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" asp-for="Personal.Email" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại</label>
                            <input type="text" class="form-control" asp-for="Personal.Phone" />
                        </div>
                        
                        <div class="mt-3 text-center">
                            <a asp-action="EditPersonal" asp-route-id="@Model.Personal.EmployerId"
                               class="btn btn-gradient w-50 mx-auto">
                                <i class="fas fa-user-edit me-1"></i> Cập nhật
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>

        <!-- 🏢 Thông tin công ty -->
        <div class="col-lg-6">
            <div class="card card-custom h-100">
                <div class="card-header-custom bg-success text-white">
                    <i class="bi bi-buildings me-2"></i> Thông tin công ty
                </div>
                <div class="card-body">
                    <form asp-action="EditCompany" method="post">
                        <input type="hidden" asp-for="Company.CompanyID" />
                        <div class="mb-3">
                            <label class="form-label">Tên công ty</label>
                            <input type="text" class="form-control" asp-for="Company.CompanyName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mô tả</label>
                            <textarea class="form-control" asp-for="Company.Description" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Địa chỉ</label>
                            <input type="text" class="form-control" asp-for="Company.Address" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Website</label>
                            <input type="url" class="form-control" asp-for="Company.Website" />
                        </div>
                        <div class="mt-3 text-center">
                        <a asp-action="EditCompany" asp-route-id="@Model.Company.CompanyID"
                           class="btn btn-gradient  w-50 mx-auto">
                            <i class="fas fa-building"></i> Cập nhật
                        </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Dashboard" class="btn btn-secondary px-4 rounded-pill">
            ⬅️ Quay lại Dashboard
        </a>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
