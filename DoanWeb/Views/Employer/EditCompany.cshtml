@model DoanWeb.Models.CompanyViewModel
@{
    ViewData["Title"] = "Cập nhật công ty";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-lg rounded-4 w-75">
        <div class="card-body p-5">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    <i class="fas fa-times-circle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <h2 class="text-center mb-4 text-success fw-bold">
                🏢 Cập nhật thông tin công ty
            </h2>

            <!-- Hiển thị thông báo -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-pill" role="alert">
                    ✅ @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-pill" role="alert">
                    ❌ @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="EditCompany" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="CompanyID" />

                <div class="row">
                    <!-- Cột trái -->
                    <div class="col-md-6 pe-4 border-end">
                        <div class="mb-3">
                            <label asp-for="CompanyName" class="form-label fw-bold">
                                <i class="fas fa-building"></i> Tên công ty
                            </label>
                            <input asp-for="CompanyName" class="form-control rounded-pill" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">
                                <i class="fas fa-map-marker-alt"></i> Địa chỉ
                            </label>
                            <input asp-for="Address" class="form-control rounded-pill" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- 🖼 Logo -->
                        <!-- 🖼 Logo -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-image"></i> Logo công ty
                            </label>

                            <!-- Nếu đã có logo cũ -->
                            @if (!string.IsNullOrEmpty(Model.Logo))
                            {
                                <div class="mb-2">
                                    <img src="@Model.Logo" alt="Logo công ty" class="img-thumbnail" style="max-height:120px;" />
                                </div>
                            }

                            <!-- Ảnh preview logo mới -->
                            <div class="mb-2">
                                <img id="logoPreview" src="#" alt="Xem trước logo mới"
                                     class="img-thumbnail d-none" style="max-height:120px;" />
                            </div>

                            <!-- Input chọn file -->
                            <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" onchange="previewLogo(event)" />
                            <span asp-validation-for="LogoFile" class="text-danger small"></span>
                        </div>

                        

                        </div>

                    <!-- Cột phải -->
                    <div class="col-md-6 ps-4">
                        <div class="mb-3">
                            <label asp-for="Website" class="form-label fw-bold">
                                <i class="fas fa-globe"></i> Website
                            </label>
                            <input asp-for="Website" class="form-control rounded-pill" />
                            <span asp-validation-for="Website" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">
                                <i class="fas fa-align-left"></i> Giới thiệu
                            </label>
                            <textarea asp-for="Description" class="form-control rounded-4" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Nút -->
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Profile" class="btn btn-outline-secondary px-4 rounded-pill">
                        ⬅️ Quay lại
                    </a>
                    <button type="submit" class="btn btn-success px-4 rounded-pill">
                        💾 Lưu thay đổi
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- Font Awesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<script src="~/js/company.js"></script>
