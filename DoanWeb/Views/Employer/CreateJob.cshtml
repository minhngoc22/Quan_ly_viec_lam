@model DoanWeb.Models.JobFormViewModel
@{
    ViewData["Title"] = "Tạo việc làm";
}

<link rel="stylesheet" href="~/css/jobform.css" />
<div class="job-form-a4 container my-4">
    <div class="card shadow-sm rounded-2 mx-auto">
        <div class="card-header bg-primary text-white text-center py-2">
            <h4 class="mb-0"><i class="bi bi-briefcase-fill me-1"></i> Đăng tin tuyển dụng</h4>
        </div>

        <div class="card-body p-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success small mb-2">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger small mb-2">@TempData["ErrorMessage"]</div>
            }

            <!-- Form import file Word/Excel -->
            <!-- =================== Form tải template Word =================== -->
            <form asp-action="DownloadJobTemplate"  method="get">
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-download me-1"></i> Tải form mẫu Word
                </button>
            </form>

            <!-- =================== Form import Word/Excel =================== -->
            <!-- Form import Word/Excel tự động submit -->
            <form asp-action="ImportWord"  method="post" enctype="multipart/form-data" id="importForm">
                <label class="form-label fw-bold small">Import Jobs từ file Word/Excel</label>
                <input type="file" name="wordFile" accept=".docx,.xlsx" class="form-control form-control-sm mb-2"
                       onchange="document.getElementById('importForm').submit();" />
            </form>



            <form asp-action="CreateJob" method="post" enctype="multipart/form-data">
                <!-- Tiêu đề & Lương -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="Job.Title" class="form-label fw-bold small">Tiêu đề</label>
                        <input asp-for="Job.Title" class="form-control form-control-sm" placeholder="Tiêu đề..." />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Job.Salary" class="form-label fw-bold small">Mức Lương</label>
                        <input asp-for="Job.Salary" class="form-control form-control-sm" placeholder="VD: 15000000" />
                    </div>
                </div>

                <!-- Mô tả -->
                <div class="mb-2">
                    <label asp-for="Job.Description" class="form-label fw-bold small">Mô tả công việc</label>
                    <textarea asp-for="Job.Description" class="form-control" rows="5"></textarea>
                </div>

                <!-- Yêu cầu -->
                <div class="mb-2">
                    <label asp-for="Job.Requirements" class="form-label fw-bold small">Yêu cầu công việc </label>
                    <textarea asp-for="Job.Requirements" class="form-control" rows="4"></textarea>
                </div>

                <!-- Quyền lợi -->
                <div class="mb-2">
                    <label asp-for="Job.Benefits" class="form-label fw-bold small">Quyền lợi</label>
                    <textarea asp-for="Job.Benefits" class="form-control" rows="3" placeholder="VD: Lương hấp dẫn, BHXH, đào tạo..."></textarea>
                </div>

                <!-- Địa điểm & Tỉnh -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="Job.Location" class="form-label fw-bold small">Địa địa làm việc</label>
                        <input asp-for="Job.Location" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Job.ProvinceId" class="form-label fw-bold small">Tỉnh thành</label>
                        <select asp-for="Job.ProvinceId" asp-items="Model.Provinces" class="form-select form-select-sm"></select>
                    </div>
                </div>

                <!-- Ngành nghề & Công ty -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="Job.CategoryId" class="form-label fw-bold small">Ngành nghề</label>
                        <select asp-for="Job.CategoryId" asp-items="Model.Categories" class="form-select form-select-sm"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Job.CompanyId" class="form-label fw-bold small">Công ty </label>
                        <select asp-for="Job.CompanyId" asp-items="Model.Companies" class="form-select form-select-sm"></select>
                    </div>
                </div>
                <!-- Giới tính & Số lượng -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="Job.GenderRequirement" class="form-label fw-bold small">Giới tính</label>
                        <select asp-for="Job.GenderRequirement" class="form-select form-select-sm">
                            <option value="">Không yêu cầu</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Job.VacancyCount" class="form-label fw-bold small">Số lượng</label>
                        <input asp-for="Job.VacancyCount" type="number" min="1" class="form-control form-control-sm" placeholder="VD: 5" />
                    </div>
                </div>


                <!-- Loại công việc & Hạn nộp -->
                <div class="row mb-2">
                    <div class="col-md-6">
                        <label asp-for="Job.JobType" class="form-label fw-bold small">Loại công việc</label>
                        <select asp-for="Job.JobType" class="form-select form-select-sm">
                            <option value="">-- Chọn --</option>
                            <option value="Full-time">Full-time</option>
                            <option value="Part-time">Part-time</option>
                            <option value="Internship">Thực tập</option>
                            <option value="Remote">Remote</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Job.ExpireDate" class="form-label fw-bold small">Hạn nộp</label>
                        <input asp-for="Job.ExpireDate" type="date" class="form-control form-control-sm" />
                    </div>
                </div>


                <!-- Từ khóa & Ảnh -->
                <div class="mb-2">
                    <label asp-for="Job.Keywords" class="form-label fw-bold small">Từ khóa tìm kiếm</label>
                    <input asp-for="Job.Keywords" class="form-control form-control-sm" placeholder="VD: lập trình, .NET..." />
                </div>
                <div class="mb-2">
                    <label asp-for="Job.ImageUrl" class="form-label fw-bold small">Ảnh mô tả</label>
                    <input asp-for="Job.ImageUrl" type="file" class="form-control form-control-sm" name="ImageFile" />
                </div>



                <div class="d-flex justify-content-between mt-3">
                    <a asp-action="ManageJobs" class="btn btn-outline-secondary btn-sm px-3">Quay lại</a>
                    <button type="submit" class="btn btn-primary btn-sm px-3">Đăng tin</button>
                </div>
            </form>
        </div>
    </div>
</div>
